# Docker deployment configuration (copy to .env)
# The image is built locally by `docker compose build`; there is no registry tag.
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when ARTEX runs inside WSL.
ARTEX_BIND_ADDR=127.0.0.1
# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate
# limit trusts. Empty: the header is ignored. See "Reverse proxy deployment" in README.md.
ARTEX_TRUSTED_PROXIES=
POSTGRES_USER=artex
# Bootstrap/maintenance identity: never use this role as ARTEX's runtime role.
POSTGRES_PASSWORD=
# Separate artex_app password, used only by first-start postgres init.
# Generate a long random value; URL-encode it when inserting it into ARTEX_PG_DSN.
ARTEX_APP_PASSWORD=
# Full URL for the dedicated runtime role. The application fails closed for
# superusers, server-file/program privileges, or elevated role memberships.
ARTEX_PG_DSN=postgres://artex_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@postgres:5432/artex?sslmode=disable
POSTGRES_DB=artex

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
